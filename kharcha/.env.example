# ---- Server (set these in Vercel > Project > Settings > Environment Variables) ----
# MongoDB Atlas free (M0) connection string, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DB_NAME=kharcha
# Long random string (24+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional, comma-separated extra origins allowed to call the API (the web app on the same domain needs nothing)
ALLOWED_ORIGINS=

# ---- App (build time) ----
# Full URL of your Vercel deployment, used by the native Android/iOS app. Leave empty for the web build.
EXPO_PUBLIC_API_URL=
