{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-VERCEL-URL" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-VERCEL-URL" }
    }
  },
  "submit": { "production": {} }
}
